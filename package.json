{
  "name": "mzansiville",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "seed": "node scripts/seed.mjs",
    "check": "node scripts/sim-check.mjs",
    "shots": "playwright test",
    "test:cameras": "playwright test tests/screenshots.spec.js -g cam-",
    "test:cameras:edge": "playwright test tests/screenshots.spec.js -g cam- --config playwright.edge.config.js",
    "test:e2e": "playwright test --config playwright.edge.config.js --project=timing --workers=1 && playwright test --config playwright.edge.config.js --project=rest --workers=2",
    "test:quick": "npm run check && playwright test --config playwright.edge.config.js --project=quick --workers=2"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.2.1",
    "@gltf-transform/extensions": "^4.2.1",
    "@gltf-transform/functions": "^4.2.1",
    "@playwright/test": "^1.64.1",
    "draco3dgltf": "^1.5.7",
    "vite": "^6.3.5"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "three": "^0.187.0"
  }
}
