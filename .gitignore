# Test videos and screenshots stay on this machine; reports name them by file.
docs/sprints/**/*.webm
docs/sprints/**/*.png
docs/sprints/**/*.jpg
docs/sprints/**/*.jpeg
# Test reports (JSON) stay on this machine too; docs/sprints/presence/results.json was committed before this and stays.
docs/sprints/**/*.json
# Claude preview pane config (local tool setting)
.claude/launch.json
# Lighthouse reports stay local too (the scores go in the sprint report).
docs/sprints/**/*.report.html
# The website's original photos (site/img-src/) are big; the WebP made from them is committed.
site/img-src/*
!site/img-src/README.md

# Claude Code local permissions (per machine)
.claude/settings.local.json
